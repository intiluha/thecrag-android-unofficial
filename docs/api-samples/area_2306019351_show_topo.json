There is an easy way to cross the river involving a large pipe/cable.","name":"Approach"}],"depth":3,"displayAverageHeight":[19,"m"],"hasUnarchivedChildren":1,"hide":{},"id":"2306004858","isTLC":1,"kudos":398,"locatedness":101,"maxPop":37,"name":"Ohanavan","numberRoutes":21,"numberTopos":11,"permitNode":{"node":{"id":"2306004858"}},"priceCategory":"Emerging","redirectStubs":[],"siblingLabel":17,"subAreaCount":2,"subType":"Crag","tlc":{"node":{"id":"2306004858"}},"totalFavorites":2,"type":"area","unique":"Easy and hard sport routes in an amazing gorge.\nDifficulty ratings tend to be underrated.","urlAncestorStub":"armenia"},"lastUpdated":1726143981,"linked":"true","node":"2306004858","objects":[{"ascentCount":69,"asciiName":"West","averageHeight":[23,"m"],"beta":[{"markdown":"Some of the routes rising directly from the river.","name":"Description"},{"markdown":"Watch out when unclipping the last quickdraw; the added slack might drop you into the river! Collect your rope from the other shore, it might get a little wet.","name":"Descent Notes"}],"depth":4,"displayAverageHeight":[23,"m"],"hasUnarchivedChildren":1,"hide":{},"id":"2306019351","kudos":196,"locatedness":66,"maxPop":29,"name":"West","numberRoutes":11,"numberTopos":6,"objectID":2306019351,"objectType":"Area","parentObjectID":2306004858,"permitNode":{"node":{"id":"2306004858"}},"priceCategory":"Emerging","redirectStubs":[],"shape":"346.48711943793927 250.8388831967214 lbvnd West,346.5 250.8,358.1 298.5,370.96018735363015 293.3447379976582,358.1 244.39860216627645","siblingLabel":1,"subType":"Sector","tlc":{"node":{"id":"2306004858"}},"type":"area","urlAncestorStub":"armenia"},{"ascentCount":98,"asciiName":"East","averageHeight":[15,"m"],"depth":4,"displayAverageHeight":[15,"m"],"hasUnarchivedChildren":1,"hide":{},"id":"2306029254","kudos":202,"locatedness":92,"maxPop":37,"name":"East","numberRoutes":10,"numberTopos":4,"objectID":2306029254,"objectType":"Area","parentObjectID":2306004858,"permitNode":{"node":{"